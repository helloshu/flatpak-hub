#!/bin/sh
set -eu

unset ELECTRON_RUN_AS_NODE

export TMPDIR="${XDG_RUNTIME_DIR:-/tmp}/app/${FLATPAK_ID:-io.github.anywhere_labs.DshNext}"
mkdir -p "$TMPDIR"

wayland_display="${WAYLAND_DISPLAY:-wayland-0}"
if [ -e "${XDG_RUNTIME_DIR:-/run/user/1000}/${wayland_display}" ]; then
  set -- --ozone-platform-hint=auto --enable-features=UseOzonePlatform,WaylandWindowDecorations --enable-wayland-ime "$@"
fi

exec zypak-wrapper /app/extra/dsh/app/dsh-desktop-next "$@"
